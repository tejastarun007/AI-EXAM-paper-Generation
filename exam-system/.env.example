# .env.example — copy to .env, fill all values before docker compose up

# Database
DATABASE_URL=postgresql://examuser:CHANGE_ME@postgres:5432/examdb
DB_USER=examuser
DB_PASS=CHANGE_ME

# JWT (min 64 hex chars)
JWT_SECRET=CHANGE_ME_64_HEX

# TOTP — generate: python -c 'import pyotp; print(pyotp.random_base32())'
HOD_TOTP_SECRET=BASE32XXXXXXXXXXXXXXXX
LECTURER_TOTP_SECRET=BASE32YYYYYYYYYYYYYY

# Master key for AES key encryption at rest
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MASTER_KEY=FERNET_KEY_HERE

# Watermark HMAC secret (32+ chars)
WATERMARK_SECRET=CHANGE_ME_32_CHARS_MIN

# Break-glass HMAC (64 hex chars, separate from watermark)
BREAK_GLASS_SECRET=CHANGE_ME_64_HEX

# Blockchain
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXX

# Wallet paths (relative to /app inside container)
HOD_SKEY_PATH=wallets/hod.skey
LECTURER_SKEY_PATH=wallets/lecturer.skey

# Admin IP whitelist
ADMIN_IPS=127.0.0.1
